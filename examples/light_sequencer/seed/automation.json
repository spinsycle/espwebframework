{"schema_version":1,"enabled":true,"utc_offset_min":0,"interlocks":[],
 "rules":[
  {"id":"boot_show","name":"Start show at boot","enabled":true,
   "trigger":{"type":"startup"},"match":"all","conditions":[],
   "actions":[{"type":"seq_start","device":"show"}],"cooldown_s":0},
  {"id":"nap_end","name":"Lamp off when timer ends","enabled":true,
   "trigger":{"type":"timer","device":"nap","event":"done"},"match":"all","conditions":[],
   "actions":[{"type":"off","device":"lamp"}],"cooldown_s":0}
 ],
 "sequences":[{"id":"show","name":"Light show","repeat":0,"steps":[
